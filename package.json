{
  "name": "millie-stats",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "test": "vitest run",
    "check": "biome check .",
    "fix": "biome check --write .",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute millie --local --file",
    "db:remote": "wrangler d1 execute millie --remote --file"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@solidjs/web": "^2.0.4",
    "solid-js": "^2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@solidjs/vite-plugin": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "workerd@1.20261123.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
